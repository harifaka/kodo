[build-system]
requires = ["setuptools>=69"]
build-backend = "setuptools.build_meta"

[project]
name = "{{ slug }}"
version = "0.1.0"
description = "{{ project_name }} - generated by Kodo"
requires-python = ">=3.11"
dependencies = [
    "fastapi>=0.115",
    "uvicorn[standard]>=0.32",
    "pydantic>=2.9",
    "sqlalchemy>=2.0",
]

[project.optional-dependencies]
dev = ["pytest>=8.3", "httpx>=0.27", "ruff>=0.8", "mypy>=1.13"]

[tool.setuptools.packages.find]
include = ["{{ package_root }}*"]

[tool.ruff]
line-length = 100
target-version = "py311"
