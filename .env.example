# Host port for the Kodo UI (Nginx) — http://localhost:3000
KODO_WEB_PORT=3000

# Optional: host folder bind-mounted into the api-python container as /projects.
# Defaults to the committed empty placeholder ./.kodo-empty.
# Windows example: KODO_LOCAL_PROJECTS_DIR=C:/work
# KODO_LOCAL_PROJECTS_DIR=

# Optional: extra CORS origins (comma-separated). The Docker stack is same-origin through Nginx.
# KODO_CORS_ORIGINS=

# --- Phase 8: modes, persistence and auth -------------------------------------------------
# `local` = zero-configuration self-hosting (SQLite + seeded local user, no OAuth required).
# `saas`  = fail-closed multi-tenancy: KODO_JWT_SECRET is mandatory and workspaces are sandboxed.
KODO_MODE=local

# Any SQLAlchemy URL. Default is SQLite on the kodo-data volume.
# Local Docker:   sqlite:////data/kodo/kodo.db
# Outside Docker: sqlite:///~/.kodo/kodo.db (Kodo expands ~)
# Bundled Postgres (docker compose --profile saas up):
#   KODO_DATABASE_URL=postgresql+psycopg://kodo:kodo@postgres:5432/kodo
# Managed third-party Postgres (configure later — no code change needed):
#   KODO_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Examples: Supabase, Neon, Railway, Azure Database for PostgreSQL, Amazon RDS.
KODO_DATABASE_URL=sqlite:////data/kodo/kodo.db

# HS256 session signing secret. REQUIRED (>=32 chars) when KODO_MODE=saas.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KODO_JWT_SECRET=
KODO_JWT_TTL_HOURS=24
# `auto` sets the Secure cookie flag when KODO_PUBLIC_URL starts with https://.
KODO_COOKIE_SECURE=auto
KODO_PUBLIC_URL=http://localhost:3000

# GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
# Callback URL: <KODO_PUBLIC_URL>/api/v1/auth/github/callback
KODO_GITHUB_CLIENT_ID=
KODO_GITHUB_CLIENT_SECRET=
KODO_GITHUB_SCOPES=read:user user:email

# Optional bundled PostgreSQL credentials (used by the `saas` Compose profile).
# KODO_POSTGRES_DB=kodo
# KODO_POSTGRES_USER=kodo
# KODO_POSTGRES_PASSWORD=change-me

# DeepSeek Cloud or a local OpenAI-compatible server (Ollama / vLLM).
# Keep secrets in .env only — it is git-ignored; .env.example must stay placeholder-only.
KODO_LLM_BASE_URL=https://api.deepseek.com/v1
KODO_LLM_API_KEY=
KODO_LLM_CODE_MODEL=deepseek-chat
KODO_LLM_REASONING_MODEL=deepseek-reasoner
KODO_LLM_TIMEOUT_SECONDS=90

# --- Phase 9: ephemeral builders -----------------------------------------------------------
# Build the images once: docker compose --profile builders build
# Verification is local-first: enabled by default in `local`, opt-in in `saas`.
KODO_BUILDERS_ENABLED=true
KODO_BUILDER_IMAGE_JAVA=kodo-builder-java:local
KODO_BUILDER_IMAGE_CSHARP=kodo-builder-csharp:local
KODO_BUILDER_IMAGE_NODEJS=kodo-builder-nodejs:local
# Hardened default: no network in the build container. Only override for a trusted, local build.
KODO_BUILDER_NETWORK_MODE=none
KODO_BUILDER_TIMEOUT_SECONDS=120
KODO_BUILDER_MEMORY=1g
KODO_BUILDER_CPUS=1
KODO_BUILDER_PIDS_LIMIT=256
# Docker-outside-of-docker socket gid for the api-python user (see docker-compose.override.yml.example).
# DOCKER_GID=999

# --- Phase 10: System 1 (Laya) decision layer (advisory) -----------------------------------
# Optional fast local intuition in front of DeepSeek (System 2). Kodo keeps working with
# deterministic rules + manual DeepSeek triggers when this is disabled or unreachable.
KODO_SYSTEMONE_ENABLED=true
# In Docker with `--profile ai-local` the bundled service is http://ollama:11434.
# Outside Docker / a non-Docker API process, use http://localhost:11434 (Ollama) or
# http://localhost:8000 (laya-serve).
KODO_SYSTEMONE_BASE_URL=http://ollama:11434
KODO_SYSTEMONE_MODEL=laya
# Optional bearer token for a hosted /v1/systemone endpoint. Local Ollama and laya-serve
# accept an empty key; this value is never logged or stored in the database.
KODO_SYSTEMONE_API_KEY=
KODO_SYSTEMONE_TIMEOUT_SECONDS=10
# Calibrated confidence below which Kodo escalates to System 2 / human review.
KODO_SYSTEMONE_AUTO_THRESHOLD=0.78

# docker-compose.prod.yml only — GHCR image coordinates.
KODO_IMAGE_OWNER=harifaka
KODO_TAG=latest
