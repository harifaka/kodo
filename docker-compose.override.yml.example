# Copy to docker-compose.override.yml (git-ignored) to extend the local stack.
# `docker compose up` picks that file up automatically.
services:
  api-python:
    # Expose FastAPI directly for /docs or for a host-run Vite dev server.
    ports:
      - "${KODO_API_PORT:-8088}:8088"
    volumes:
      # Additional read/write host folders; the first mount already comes from KODO_LOCAL_PROJECTS_DIR.
      - type: bind
        source: C:/work
        target: /projects/work
      # --- Phase 9 -------------------------------------------------------------
      # Ephemeral build verification drives a Docker daemon (docker-outside-of-docker). Mount the
      # host socket only for local self-hosting — never in SaaS — and grant the kodo user the
      # socket's group id. Without this mount, Verify Build simply reports "Builder Offline".
      # - type: bind
      #   source: /var/run/docker.sock
      #   target: /var/run/docker.sock
    # group_add:
    #   - "${DOCKER_GID:-999}"
